# 複製成 .env 再修改（.env 不會被 git 追蹤，請不要把它上傳到 GitHub）

# 一長串隨機文字，用來簽署登入狀態。產生方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 後台帳號與密碼。密碼要先用這個指令轉成雜湊值再貼上：
#   python manage.py hash-password
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# 資料庫。沒設定就使用本機的 SQLite 檔；正式環境建議用 PostgreSQL。
# DATABASE_URL=postgresql://使用者:密碼@主機/資料庫

# 放在 Render、Railway 等代理後面時設成 1，才能取得訪客真正的 IP
# TRUST_PROXY=1
